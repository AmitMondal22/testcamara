{
  "app": {
    "title": "Vision Scraper - Raspberry Pi 4 Model B Dialysis Telemetry Engine",
    "extraction_interval_seconds": 1.0,
    "burst_frame_count": 3,
    "burst_delay_seconds": 0.05,
    "output_dir": "output",
    "save_capture_images": true,
    "save_telemetry_json": true,
    "realtime_terminal_print": true,
    "headless": true,
    "camera_type": "usb"
  },
  "hardware": {
    "target_platform": "raspberry_pi_4",
    "use_v4l2": true,
    "default_camera_index": 0,
    "camera_width": 1280,
    "camera_height": 720,
    "camera_fps": 30,
    "thread_workers": 4
  },
  "ocr": {
    "engine": "auto",
    "fallback_engine": "tesseract",
    "easyocr_gpu": false,
    "tesseract_psm": 6,
    "tesseract_oem": 1,
    "digit_whitelist": "0123456789.:,-",
    "max_ocr_dimension": 800
  },
  "deskew_tilt": {
    "enable_auto_unwarp": true,
    "enable_tilt_deskew": true,
    "min_contour_area_ratio": 0.08,
    "canny_thresh_low": 30,
    "canny_thresh_high": 150,
    "max_tilt_angle_deg": 45.0,
    "clahe_clip_limit": 3.0,
    "clahe_tile_grid_size": [8, 8]
  },
  "dialysis_fields": {
    "UF Volume": {
      "unit": "ml",
      "type": "number"
    },
    "UF Time Left": {
      "unit": "h:min",
      "type": "time"
    },
    "UF Rate": {
      "unit": "ml/h",
      "type": "number"
    },
    "UF Goal": {
      "unit": "ml",
      "type": "number"
    },
    "Eff. Blood Flow": {
      "unit": "ml/min",
      "type": "number"
    },
    "Cum. Blood Vol.": {
      "unit": "l",
      "type": "number"
    },
    "Kt/V": {
      "unit": "",
      "type": "number"
    },
    "Plasma Na": {
      "unit": "mmol/l",
      "type": "number"
    },
    "Goal in": {
      "unit": "h:min",
      "type": "time"
    },
    "Clearance": {
      "unit": "ml/min",
      "type": "number"
    }
  },
  "devices": [
    {
      "id": "001",
      "name": "USB Webcam",
      "ip": "127.0.0.1",
      "rtsp_url": "0",
      "mode": "dialysis",
      "extraction_interval": 1.0,
      "burst_count": 3,
      "show_boxes": false
    }
  ]
}
